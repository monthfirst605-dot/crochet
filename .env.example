# Neon — use the POOLED connection string ("-pooler" in the host).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 32+ random chars. Signs the admin session cookie. Rotating it logs everyone out.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Image uploads via Cloudflare R2. Leave all four empty if you'd rather
# paste image URLs into the admin form instead of uploading files.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# The bucket's public URL (r2.dev, or a custom domain attached to the bucket).
# No trailing slash.
R2_PUBLIC_URL=""

# Shown on the storefront.
NEXT_PUBLIC_SITE_NAME="Moon & Thread"
NEXT_PUBLIC_WHATSAPP="919000000000"
SHIPPING_FLAT_PAISE="9900"
FREE_SHIPPING_OVER_PAISE="200000"
