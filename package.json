{
  "name": "moon-and-thread",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:worker": "npx opennextjs-cloudflare build",
    "preview:worker": "npx opennextjs-cloudflare build && npx opennextjs-cloudflare preview",
    "deploy:worker": "npx opennextjs-cloudflare build && npx wrangler deploy",
    "db:setup": "node --env-file=.env.local scripts/run-sql.mjs db/schema.sql",
    "db:seed": "node --env-file=.env.local scripts/run-sql.mjs db/seed.sql",
    "admin:create": "node --env-file=.env.local scripts/create-admin.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@neondatabase/serverless": "^1.0.1",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.0.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.8.3",
    "wrangler": "^4.125.0"
  },
  "engines": { "node": ">=20.11" }
}
